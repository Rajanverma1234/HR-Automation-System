GEMINI_API_KEY=
# Optional: override the default Gemini model, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
# HR dashboard login (optional locally, required on Vercel). Make entries with `npm run hr-user -- you@company.com`,
# comma-separated for several recruiters, and a secret with `npm run hr-user -- --secret`.
HR_USERS=
AUTH_SECRET=
