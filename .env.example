GEMINI_API_KEY=
# Optional: override the default Gemini model, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
# HR dashboard login (optional locally, required on Vercel). Super admins only: make entries with
# `npm run hr-user -- nisha --name Nisha` (comma-separated for several), and a secret with `npm run hr-user -- --secret`.
# Recruiters are added by a super admin on the dashboard's Team page.
HR_USERS=
AUTH_SECRET=
